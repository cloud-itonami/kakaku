{
  "@context": "https://etzhayyim.com/ns/actor/v1",
  "@id": "did:web:kakaku.etzhayyim.com",
  "actors": [
    {
      "description": "ISCO 2434 — canonical product creation, normalization, and category assignment",
      "displayName": "Catalog",
      "path": "actor:catalog"
    },
    {
      "description": "ISCO 3339 — merchant registration, verification, crawl policy, trust metadata",
      "displayName": "Merchant Registry",
      "path": "actor:merchantRegistry"
    },
    {
      "description": "ISCO 4132 — cross-site price, stock, shipping, and URL observation",
      "displayName": "Offer Ingest",
      "path": "actor:offerIngest"
    },
    {
      "description": "ISCO 2120 — source listing to canonical product reconciliation",
      "displayName": "Matcher",
      "path": "actor:matcher"
    },
    {
      "description": "ISCO 3313 — price delta detection, history append, alerting",
      "displayName": "Price Monitor",
      "path": "actor:priceMonitor"
    },
    {
      "description": "ISCO 2431 — cheapest and best-overall ranking with shipping and trust weighting",
      "displayName": "Ranking",
      "path": "actor:ranking"
    }
  ],
  "capabilities": [
    "graph.query",
    "graph.write",
    "agent.chat",
    "agent.invoke",
    "derive:social"
  ],
  "complianceDocs": [
    "90-docs/rules/compliance/per-did-kyumei-shinka-autonomy.md",
    "90-docs/platform/260403-live-data-kyumei-shinka-consolidated.md"
  ],
  "convoSystemPrompt": "You are the Kakaku price comparison actor. You manage canonical products, merchant registry, merchant-specific offers, and price history. Price is not a product attribute. Price belongs to an offer at a merchant at a point in time. Resolve path-based DIDs deterministically for products, merchants, and offers. Match offers to canonical products via JAN, GTIN, MPN, brand, and normalized title. Rank by total landed price, availability, delivery speed, and merchant trust.",
  "description": "Price comparison actor for canonical products, merchant registry, cross-site offer ingest, lowest-price updates, and price history. Separates product identity from merchant-specific offers and time-series price observations. Uses path-based DID resolution for product, merchant, and offer entities.",
  "displayName": "Kakaku Price Comparison",
  "domainKnowledgeRequired": true,
  "runtime": "k8s-langserver",
  "edge": "sveltekit-proxy",
  "legacyExecutionTier": "T1",
  "governance": {
    "classification": "internal",
    "raci": "responsible"
  },
  "heartbeatRequired": true,
  "name": "kakaku",
  "nanoid": "k4k4kux1",
  "performerType": "service",
  "pipelines": [
    {
      "steps": [
        {
          "args": {
            "datalog": "[:find ?merchantId ?name ?domain :where [?m :merchant/status :active] [?m :merchant/id ?merchantId] [?m :merchant/name ?name] [?m :merchant/domain ?domain]]"
          },
          "fn": "graph.query",
          "id": "activeMerchants"
        },
        {
          "args": {
            "message": "Create a refresh plan for price comparison ingest. Merchants: $activeMerchants.rows. Return compact JSON with crawl priority by merchant considering freshness and likely price volatility."
          },
          "fn": "agent.chat",
          "id": "refreshPlan"
        },
        {
          "args": {
            "template": "Kakaku refresh cycle planned for $activeMerchants.rows.length merchants."
          },
          "fn": "derive:social",
          "id": "announce"
        }
      ],
      "trigger": {
        "cron": "0 */3 * * *",
        "type": "cron"
      }
    },
    {
      "steps": [
        {
          "args": {
            "datalog": "[:find ?price ?shippingFee ?totalPrice ?availability ?observedAt :in $ ?offerId :where [?o :offer/id ?offerId] [?o :offer/price ?price] [?o :offer/shipping-fee ?shippingFee] [?o :offer/total-price ?totalPrice] [?o :offer/availability ?availability] [?o :offer/observed-at ?observedAt]]",
            "in": ["$input.record.offerId"]
          },
          "fn": "graph.query",
          "id": "currentOffer"
        },
        {
          "args": {
            "tx": [
              {
                ":ph/product": "$input.record.productId",
                ":ph/merchant": "$input.record.merchantId",
                ":ph/offer": "$input.record.offerId",
                ":ph/total-price": "$input.record.totalPrice",
                ":ph/availability": "$input.record.availability",
                ":ph/observed-at": "$input.record.observedAt"
              }
            ]
          },
          "fn": "graph.write",
          "id": "writeHistory"
        },
        {
          "args": {
            "datalog": "[:find ?merchantId ?totalPrice ?availability :in $ ?productId :where [?o :offer/product ?productId] [?o :offer/merchant ?merchantId] [?o :offer/total-price ?totalPrice] [?o :offer/availability ?availability]]",
            "in": ["$input.record.productId"],
            "order-by": ["?totalPrice", "asc"],
            "limit": 1
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "lowestOffer"
        },
        {
          "args": {
            "template": "Kakaku price update for product $input.record.productId: merchant $input.record.merchantId now $input.record.totalPrice $input.record.currency. Current lowest: $lowestOffer.rows[0].merchantId at $lowestOffer.rows[0].totalPrice."
          },
          "depends_on": [
            "lowestOffer"
          ],
          "fn": "derive:social",
          "id": "priceAlert"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.kakaku.offer"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "message": "Review product match candidate. Candidate: $input.record. Decide approve/reject/manual-review using JAN, GTIN, MPN, brand, model, normalized title, and pack size. Return JSON only."
          },
          "fn": "agent.chat",
          "id": "matchReview"
        }
      ],
      "trigger": {
        "collections": [
          "com.etzhayyim.apps.kakaku.matchCandidate"
        ],
        "type": "subscribeRepos"
      }
    },
    {
      "steps": [
        {
          "args": {
            "datalog": "[:find ?offerId ?merchantId ?price ?shippingFee ?totalPrice ?currency ?availability ?deliveryEtaDays ?productUrl :in $ ?productId :where [?o :offer/product ?productId] [?o :offer/id ?offerId] [?o :offer/merchant ?merchantId] [?o :offer/price ?price] [?o :offer/shipping-fee ?shippingFee] [?o :offer/total-price ?totalPrice] [?o :offer/currency ?currency] [?o :offer/availability ?availability] [?o :offer/delivery-eta-days ?deliveryEtaDays] [?o :offer/product-url ?productUrl]]",
            "in": ["$input.record.productId"],
            "order-by": ["?totalPrice", "asc"],
            "limit": 50
          },
          "fn": "graph.query",
          "id": "productOffers"
        },
        {
          "args": {
            "datalog": "[:find ?merchantId ?reputationScore ?status :where [?m :merchant/id ?merchantId] [?m :merchant/reputation-score ?reputationScore] [?m :merchant/status ?status]]",
            "limit": 200
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "merchantScores"
        },
        {
          "args": {
            "message": "Rank offers for product $input.record.productId. Offers: $productOffers.rows. Merchant scores: $merchantScores.rows. Return JSON with bestOverall, cheapest, fastest, and suspicious offers."
          },
          "depends_on": [
            "productOffers",
            "merchantScores"
          ],
          "fn": "agent.chat",
          "id": "ranking"
        }
      ],
      "trigger": {
        "nsid": "com.etzhayyim.apps.kakaku.compareOffers",
        "type": "xrpc"
      }
    },
    {
      "steps": [
        {
          "args": {
            "datalog": "[:find (count ?e) (max ?seq) :in $ ?did :where [?e :repo ?did] [?e :_seq ?seq]]",
            "in": ["$did"]
          },
          "fn": "graph.query",
          "id": "coverageNodes"
        },
        {
          "args": {
            "datalog": "[:find ?collection (count ?e) :in $ ?did :where [?e :repo ?did] [?e :collection ?collection]]",
            "in": ["$did"],
            "order-by": ["(count ?e)", "desc"],
            "limit": 10
          },
          "depends_on": [],
          "fn": "graph.query",
          "id": "coverageCollections"
        },
        {
          "args": {
            "tx": [
              {
                ":coverage/actor-did": "$did",
                ":coverage/actor-name": "kakaku",
                ":coverage/nanoid": "k4k4kux1",
                ":coverage/bucket": "6h",
                ":coverage/collection": "com.etzhayyim.apps.kakaku.coverageSnapshot",
                ":coverage/node-count": "$coverageNodes.rows[0].nodeCount",
                ":repo": "$did"
              }
            ],
            "upsert-by": ":coverage/actor-did"
          },
          "depends_on": [
            "coverageNodes"
          ],
          "fn": "graph.write",
          "id": "coverageSnapshot"
        }
      ],
      "trigger": {
        "cron": "0 */6 * * *",
        "type": "cron"
      }
    }
  ],
  "profile": {
    "agentType": "autonomous",
    "capabilities": [
      "register-product",
      "register-merchant",
      "upsert-offer",
      "ingest-offer-from-url",
      "match-product",
      "compare-offers",
      "price-history"
    ],
    "description": "Cross-site product matching and offer comparison. Tracks merchant offers, total landed price, availability, and price history deltas.",
    "displayName": "Kakaku Price Comparison",
    "isBot": true,
    "operator": "etzhayyim.co.jp"
  },
  "requiredCollections": [
    "com.etzhayyim.apps.standard.shinkaEvolution",
    "com.etzhayyim.apps.standard.shinkaKnowledge"
  ],
  "requiredLoops": [
    "shinka",
    "koji",
    "kyumei",
    "domain-knowledge"
  ],
  "standardRule": "per-did-kyumei-shinka-autonomy@2026-04-13",
  "standardStatus": "required",
  "triggers": {
    "subscribeRepos": {
      "collections": [
        "com.etzhayyim.apps.kakaku.product",
        "com.etzhayyim.apps.kakaku.merchant",
        "com.etzhayyim.apps.kakaku.offer",
        "com.etzhayyim.apps.kakaku.priceHistory",
        "com.etzhayyim.apps.kakaku.matchCandidate"
      ]
    }
  },
  "uiType": "yoro"
}
