;; com.etzhayyim.apps.kakaku.spread — lexicon (EDN form)
;; ADR-2605091200. A DERIVED cross-merchant/region price-difference observation.
;; G2: buyer-transparency + supply-resilience signal, NEVER a trading instruction.
{:lexicon 1
 :id "com.etzhayyim.apps.kakaku.spread"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["productId" "minLanded" "maxLanded" "spread" "spreadFraction" "observedAt"]
    :properties
    {:productId       {:type "string"}
     :minLanded       {:type "integer"}
     :maxLanded       {:type "integer"}
     :cheapestMerchant {:type "string"}
     :dearestMerchant {:type "string"}
     :spread          {:type "integer" :description "maxLanded - minLanded"}
     :spreadFraction  {:type "number" :description "spread / minLanded; >= 0.15 ⇒ notable"}
     :notable         {:type "boolean"}
     :intent          {:type "string" :description "G2 invariant: buyer-transparency+supply-resilience, never a trade"}
     :observedAt      {:type "string"}}}}}}
