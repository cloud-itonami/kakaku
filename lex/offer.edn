;; com.etzhayyim.apps.kakaku.offer — lexicon (EDN form)
;; ADR-2605091200. A merchant-specific current offer. Price lives here (+ history),
;; never on the canonical product. Comparison ranks on totalPrice (landed), not sticker.
{:lexicon 1
 :id "com.etzhayyim.apps.kakaku.offer"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["offerId" "productId" "merchantId" "price" "totalPrice" "observedAt"]
    :properties
    {:offerId         {:type "string"}
     :productId       {:type "string"}
     :merchantId      {:type "string"}
     :price           {:type "integer" :description "sticker price, minor currency units"}
     :shippingFee     {:type "integer"}
     :totalPrice      {:type "integer" :description "landed = price + shippingFee; the comparison basis"}
     :currency        {:type "string" :description "ISO-4217"}
     :availability    {:type "string" :description "in-stock|preorder|backorder|out-of-stock|unknown"}
     :deliveryEtaDays {:type "integer"}
     :region          {:type "string" :description "merchant region for cross-region arbitrage spread"}
     :productUrl      {:type "string" :description "AFFILIATE-STRIPPED source URL (G3)"}
     :observedAt      {:type "string" :description "ISO timestamp"}}}}}}
