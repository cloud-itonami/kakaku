;; com.etzhayyim.apps.kakaku.supplyDemand — lexicon (EDN form)
;; ADR-2605091200. A DERIVED present-state supply/demand index in [-1,1].
;; G2: describes the present public market, NOT a forecast (mitooshi owns futures).
{:lexicon 1
 :id "com.etzhayyim.apps.kakaku.supplyDemand"
 :defs
 {:main
  {:type "record"
   :key "tid"
   :record
   {:type "object"
    :required ["productId" "supplyDemandIndex" "reading" "observedAt"]
    :properties
    {:productId         {:type "string"}
     :supplyDemandIndex {:type "number" :description "[-1,1]; +1 scarcity, -1 glut"}
     :inStockRatio      {:type "number" :description "0..1"}
     :priceVelocity     {:type "number" :description "signed fractional change over the window"}
     :reading           {:type "string" :description "scarcity|balanced|glut"}
     :kind              {:type "string" :description "G2: present-state index, not a forecast"}
     :observedAt        {:type "string"}}}}}}
