;; kakaku 価格 — offer_ingest cell (langgraph, wasm runtime)
;; ADR-2605091200 — maps to py/ingest.py ingest_offer_from_url
{:cell/id "offer_ingest"
 :cell/glyph "価格"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/entry "py/ingest.py"
 :cell/handler "ingest_offer_from_url"
 :cell/doc "Turn a fetched product page into a canonical offer via a tiered extractor: JSON-LD schema.org Product/Offer → merchant selector profile → meta/regex → Murakumo LLM fill for STILL-missing fields (G5). The network FETCH is the only operator-gated step (G11, no-server-key): a live fetch is refused without an operator ref; extraction runs on pre-fetched content. Source URLs are affiliate-stripped (G3)."
 :cell/llm
 {:provider :murakumo
  :endpoint "127.0.0.1:4000"
  :model "gemma3:4b"
  :charter-rider true}
 :cell/gates ["G3" "G5" "G6" "G11"]
 :cell/kotoba
 {:reads [:merchant/selector-profile]
  :writes [:offer/price :offer/currency :offer/availability :offer/product-url :offer/observed-at]}}
