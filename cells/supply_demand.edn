;; kakaku 価格 — supply_demand cell (langgraph, wasm runtime)
;; ADR-2605091200 — maps to py/agent.py handle_supply_demand
{:cell/id "supply_demand"
 :cell/glyph "価格"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/doc "bounded [-1,1] PRESENT-STATE supply/demand index from in-stock ratio + price velocity. +1 scarcity, -1 glut. NOT a forecast (G2; mitooshi owns futures). Emits :sd/* observation."
 :cell/handler "agent.handle_supply_demand"
 :cell/gates ["G2" "G6"]
 :cell/kotoba
 {:reads [:offer/availability :ph/total-price :ph/observed-at]
  :writes [:sd/product :sd/index :sd/in-stock-ratio :sd/reading :sd/observed-at]}}
