;; kakaku 価格 — arbitrage cell (langgraph, wasm runtime)
;; ADR-2605091200 — maps to py/agent.py handle_arbitrage
{:cell/id "arbitrage"
 :cell/glyph "価格"
 :cell/kind :langgraph
 :cell/runtime :wasm
 :cell/doc "cross-merchant + cross-region landed-price SPREAD for one product. BUYER transparency + supply resilience, NEVER a trading signal (G2). Emits a :spread/* observation."
 :cell/handler "agent.handle_arbitrage"
 :cell/gates ["G2" "G6"]
 :cell/kotoba
 {:reads [:offer/total-price :offer/merchant :merchant/region]
  :writes [:spread/product :spread/min-landed :spread/max-landed :spread/fraction :spread/observed-at]}}
